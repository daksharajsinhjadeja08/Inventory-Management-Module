
@model InventoryManagement.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<h2>Add New Product</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="ProductName">Product Name</label>
        <input asp-for="ProductName" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Quantity">Quantity</label>
        <input asp-for="Quantity" type="number" min="0" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price">Price</label>
        <input asp-for="Price" type="number" min="0" step="0.01" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Category">Category</label>
        <input asp-for="Category" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Save Product</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
