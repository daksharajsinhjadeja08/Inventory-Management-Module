@model InventoryManagement.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ProductId" />

    <div class="form-group mb-3">
        <label asp-for="ProductName">Product Name</label>
        <input asp-for="ProductName" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Quantity">Quantity</label>
        <input asp-for="Quantity" type="number"
               min="0" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price">Price</label>
        <input asp-for="Price" type="number"
               min="0" step="0.01" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Category">Category</label>
        <input asp-for="Category" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">
        Update Product
    </button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>